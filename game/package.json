{
  "name": "game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "smoke": "node tools/preview-smoke.mjs",
    "e2e:prod": "npm run build && playwright test -c playwright.prod.config.ts",
    "build:verify": "npm run build && npm run smoke",
    "test": "vitest run",
    "test:pure": "vitest run -c vitest.pure.config.ts",
    "coverage": "vitest run --coverage",
    "re:audiodiff": "vitest run tests/audiodiff.test.ts",
    "re:audiodiff:render": "tsx tools/audiodiff/render-cues.ts tools/audiodiff/out",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:pixeldiff": "playwright test -c tools/pixeldiff/capture.config.ts --grep @samestate",
    "tour:spec": "playwright test -c e2e/grandtour/playwright.grandtour.config.ts",
    "tour:mirror": "python3 e2e/grandtour/mirror.py",
    "tour": "sh -c 'npm run --silent tour:spec -- \"$0\" && npm run --silent tour:mirror -- \"$0\"'",
    "tour:ch01:spec": "npm run tour:spec -- ch01",
    "tour:ch01:mirror": "npm run tour:mirror -- ch01",
    "tour:ch01": "npm run tour -- ch01",
    "tour:ch02:spec": "npm run tour:spec -- ch02",
    "tour:ch02:mirror": "npm run tour:mirror -- ch02",
    "tour:ch02": "npm run tour -- ch02",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "video:gate": "node tools/videocap/gate.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "posthog-js": "^1.412.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
